  "author": "open-pl-address contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZlamboV/open-pl-address.git",
    "directory": "packages/mcp-server"
  },
  "dependencies": {
    "open-pl-address": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
