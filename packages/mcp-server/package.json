  "description": "Model Context Protocol (MCP) server for instant Polish address search, validation, and Urząd Skarbowy detection",
  "main": "./dist/index.js",
  "bin": {
    "open-pl-address-mcp": "./dist/index.js"
  },
  "type": "module",
